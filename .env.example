# Sanctuary - Environment Variables
# Copy this file to .env and fill in your values

# Deployer private key (WITHOUT 0x prefix) for Hardhat contract deployment
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Official COTI V2 Testnet RPC
COTI_RPC_URL=https://testnet.coti.io/rpc

# Deployed contract address (filled after deployment)
NEXT_PUBLIC_CONTRACT_ADDRESS=

# WalletConnect Project ID (get one at https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=3a64810435d24b61ef2d0b59a3ec0150
